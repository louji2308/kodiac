{
  "$defs": {
    "Component": {
      "description": "Physical component measurement with uncertainty and margin.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "margin": {
          "title": "Margin",
          "type": "number"
        },
        "sigma": {
          "title": "Sigma",
          "type": "number"
        },
        "unit": {
          "enum": [
            "cm",
            "s",
            "ratio",
            "cm/s"
          ],
          "title": "Unit",
          "type": "string"
        },
        "tri": {
          "$ref": "#/$defs/Tri"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "value",
        "threshold",
        "margin",
        "sigma",
        "unit",
        "tri"
      ],
      "title": "Component",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Canonical reason codes required whenever an evaluation yields CANT_TELL.",
      "enum": [
        "not_visible",
        "occluded",
        "below_noise_floor",
        "view_blocked",
        "appearance_unresolved",
        "depth_ambiguous"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "Tri": {
      "description": "3-valued Kleene logic tri-state: True (T), False (F), Unknown (U).",
      "enum": [
        "T",
        "F",
        "U"
      ],
      "title": "Tri",
      "type": "string"
    }
  },
  "description": "Per-frame evaluated predicate state.",
  "properties": {
    "frame": {
      "title": "Frame",
      "type": "integer"
    },
    "atom_key": {
      "title": "Atom Key",
      "type": "string"
    },
    "tri": {
      "$ref": "#/$defs/Tri"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "title": "Components",
      "type": "array"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "frame",
    "atom_key",
    "tri",
    "components",
    "trace_id"
  ],
  "title": "PredFrame",
  "type": "object"
}
