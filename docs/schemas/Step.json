{
  "$defs": {
    "Atom": {
      "description": "Atomic predicate, visual check, or manual assertion.",
      "properties": {
        "kind": {
          "enum": [
            "pred",
            "looks",
            "manual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "enum": [
                "on",
                "inside",
                "near",
                "lifted",
                "moves_with",
                "dwell"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/Param"
          },
          "title": "Params",
          "type": "array"
        },
        "looks_pos": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Looks Pos"
        },
        "looks_neg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Looks Neg"
        },
        "manual_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Text"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Atom",
      "type": "object"
    },
    "Expr": {
      "description": "Boolean expression tree over Atoms.",
      "properties": {
        "op": {
          "enum": [
            "and",
            "or",
            "not",
            "atom"
          ],
          "title": "Op",
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Expr"
          },
          "title": "Children",
          "type": "array"
        },
        "atom": {
          "anyOf": [
            {
              "$ref": "#/$defs/Atom"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "op"
      ],
      "title": "Expr",
      "type": "object"
    },
    "Param": {
      "description": "Numerical threshold parameter comparison.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "op": {
          "enum": [
            "=",
            "<=",
            ">="
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "op",
        "value"
      ],
      "title": "Param",
      "type": "object"
    },
    "Provenance": {
      "description": "Origin and grounding metadata for a step or clause.",
      "properties": {
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "t_start": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T Start"
        },
        "t_end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "T End"
        },
        "source": {
          "enum": [
            "voice",
            "text",
            "compiler-default",
            "user-edit"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "description": "One sequential step in a .green specification.",
  "properties": {
    "index": {
      "title": "Index",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "expr": {
      "$ref": "#/$defs/Expr"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "extra_provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Extra Provenance",
      "type": "array"
    }
  },
  "required": [
    "index",
    "name",
    "expr",
    "provenance"
  ],
  "title": "Step",
  "type": "object"
}
